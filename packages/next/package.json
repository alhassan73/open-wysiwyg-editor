{
  "name": "@open-wysiwyg-editor/next",
  "version": "1.0.2",
  "description": "Next.js (App Router and Pages Router) rich text editor: <RichTextEditor> with Server Actions form support. Accessible (WCAG 2.2 AA), RTL-first, CSP-safe.",
  "license": "MIT",
  "author": "alhassan-ahmed",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./style.min.css": "./dist/style.min.css",
    "./content.css": "./dist/content.css",
    "./content.min.css": "./dist/content.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "nextjs",
    "next",
    "react",
    "server-actions",
    "wysiwyg",
    "rich-text-editor",
    "editor",
    "accessibility",
    "a11y",
    "rtl",
    "arabic"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-styles.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-wysiwyg-editor/react": "^1.0.2"
  },
  "peerDependencies": {
    "next": ">=13.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://alhassan73.github.io/open-wysiwyg-editor/",
  "bugs": {
    "url": "https://github.com/alhassan73/open-wysiwyg-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alhassan73/open-wysiwyg-editor.git",
    "directory": "packages/next"
  }
}
