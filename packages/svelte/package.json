{
  "name": "@open-wysiwyg-editor/svelte",
  "version": "1.0.1",
  "description": "Svelte and SvelteKit action for open-wysiwyg-editor: <div use:richText>. Accessible (WCAG 2.2 AA), RTL-first, CSP-safe.",
  "license": "MIT",
  "author": "alhassan-ahmed",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./style.min.css": "./dist/style.min.css",
    "./content.css": "./dist/content.css",
    "./content.min.css": "./dist/content.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "svelte",
    "sveltekit",
    "svelte-action",
    "wysiwyg",
    "rich-text-editor",
    "editor",
    "accessibility",
    "a11y",
    "rtl",
    "arabic"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-styles.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "open-wysiwyg-editor": "^1.0.1"
  },
  "peerDependencies": {
    "svelte": ">=3"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tsup": "^8.5.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://alhassan73.github.io/open-wysiwyg-editor/",
  "bugs": {
    "url": "https://github.com/alhassan73/open-wysiwyg-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alhassan73/open-wysiwyg-editor.git",
    "directory": "packages/svelte"
  }
}
