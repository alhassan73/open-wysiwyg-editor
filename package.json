{
  "name": "open-wysiwyg-editor-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/next",
    "packages/preact",
    "packages/vue",
    "packages/nuxt",
    "packages/svelte",
    "packages/solid",
    "packages/angular",
    "packages/astro",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev -w examples",
    "e2e": "playwright test",
    "site": "npm run site -w examples",
    "check": "npm run lint && npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
